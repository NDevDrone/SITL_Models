# WAM-V Rover / Boat starting parameters for the original SITL_Models WAM-V
# in the gz-waves world.
#
# This keeps the original tutorial-derived WAM-V's differential-thrust control:
# SERVO1_FUNCTION=73 drives the left thruster and SERVO3_FUNCTION=74 drives the
# right thruster. The tune is intentionally slower than the calm-water starter
# params because the wave world adds a moving FFT surface and wave-aware drag.
ARMING_CHECK     0
ARMING_SKIPCHK   -1
FRAME_CLASS      2
SERVO1_FUNCTION  73
SERVO1_MIN       1000
SERVO1_MAX       2000
SERVO1_TRIM      1500
SERVO3_FUNCTION  74
SERVO3_MIN       1000
SERVO3_MAX       2000
SERVO3_TRIM      1500
CRUISE_SPEED     0.75
CRUISE_THROTTLE  34
WP_SPEED         0.75
WP_RADIUS        6.0
WP_ACCEL         0.25
WP_JERK          0.30
WP_PIVOT_ANGLE   0
WP_PIVOT_RATE    25
WP_PIVOT_DELAY   0.2
TURN_RADIUS      6.0
SPEED_MAX        0.95
ATC_ACCEL_MAX    0.30
ATC_DECEL_MAX    0.45
ATC_BRAKE        1
ATC_STOP_SPEED   0.08
ATC_STR_ANG_P    2.0
ATC_STR_RAT_FF   0.35
ATC_STR_RAT_P    0.12
ATC_STR_RAT_I    0.12
ATC_STR_RAT_D    0.0
ATC_STR_RAT_IMAX 0.5
ATC_STR_RAT_MAX  90
ATC_STR_ACC_MAX  120
ATC_STR_RAT_FLTD 2
ATC_STR_RAT_FLTE 5
ATC_STR_RAT_FLTT 5
ATC_SPEED_FF     0.16
ATC_SPEED_P      0.45
ATC_SPEED_I      0.18
ATC_SPEED_D      0.03
ATC_SPEED_IMAX   0.35
