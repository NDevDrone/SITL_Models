<?xml version="1.0"?>
<model>
  <name>WAM-V</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <sdf version="1.9">model_waves.sdf</sdf>

  <author>
    <name>Open Robotics</name>
  </author>

  <author>
    <name>ArduPilot SITL_Models contributors</name>
