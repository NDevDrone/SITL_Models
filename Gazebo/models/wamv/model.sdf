<?xml version="1.0"?>
<sdf version="1.9">
  <model name="wamv">
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="base_link">
      <inertial>
        <pose>0 0 -0.28 0 0 0</pose>
        <mass>180.0</mass>
        <inertia>
          <ixx>120.0</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>393.0</iyy>
          <iyz>0.0</iyz>
          <izz>446.0</izz>
        </inertia>
      </inertial>

      <visual name="base_visual">
        <geometry>
          <mesh>
            <uri>model://wamv/meshes/WAM-V-Base.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Box collisions keep Gazebo Sim graded buoyancy simple and portable.
           Only the pontoon volumes are collision geometry so the generic
           buoyancy system does not add lift to the bridge or payload deck. -->
      <collision name="left_hull_buoyancy">
        <pose>-0.35 1.03 0.12 0 0 0</pose>
        <geometry>
          <box>
            <size>4.80 0.34 0.36</size>
          </box>
        </geometry>
      </collision>

      <collision name="right_hull_buoyancy">
        <pose>-0.35 -1.03 0.12 0 0 0</pose>
        <geometry>
          <box>
            <size>4.80 0.34 0.36</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="imu_link">
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0.0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
      </sensor>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <link name="left_engine_link">
      <pose>-2.373776 1.027135 0.318237 0 0 0</pose>
      <visual name="left_engine_visual">
        <geometry>
          <mesh>
            <uri>model://wamv/meshes/engine.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>15.0</mass>
        <inertia>
          <ixx>0.889245</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.811125</iyy>
          <iyz>0.0</iyz>
          <izz>0.078125</izz>
        </inertia>
      </inertial>
    </link>

    <link name="left_propeller_link">
      <pose>-2.651932 1.027135 -0.191134 0 0 0</pose>
      <visual name="left_propeller_visual">
        <geometry>
          <mesh>
            <uri>model://wamv/meshes/propeller.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.008545</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.008545</iyy>
          <iyz>0.0</iyz>
          <izz>0.0144</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="left_chassis_engine_joint" type="fixed">
      <parent>base_link</parent>
      <child>left_engine_link</child>
    </joint>

    <joint name="left_engine_propeller_joint" type="revolute">
      <parent>left_engine_link</parent>
      <child>left_propeller_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <effort>100</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics>
          <friction>0.05</friction>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="right_engine_link">
      <pose>-2.373776 -1.027135 0.318237 0 0 0</pose>
      <visual name="right_engine_visual">
        <geometry>
          <mesh>
            <uri>model://wamv/meshes/engine.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>15.0</mass>
        <inertia>
          <ixx>0.889245</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.811125</iyy>
          <iyz>0.0</iyz>
          <izz>0.078125</izz>
        </inertia>
      </inertial>
    </link>

    <link name="right_propeller_link">
      <pose>-2.651932 -1.027135 -0.191134 0 0 0</pose>
      <visual name="right_propeller_visual">
        <geometry>
          <mesh>
            <uri>model://wamv/meshes/propeller.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.008545</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.008545</iyy>
          <iyz>0.0</iyz>
          <izz>0.0144</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="right_chassis_engine_joint" type="fixed">
      <parent>base_link</parent>
      <child>right_engine_link</child>
    </joint>

    <joint name="right_engine_propeller_joint" type="revolute">
      <parent>right_engine_link</parent>
      <child>right_propeller_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <effort>100</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics>
          <friction>0.05</friction>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <plugin name="gz::sim::systems::JointStatePublisher"
      filename="gz-sim-joint-state-publisher-system">
    </plugin>

    <plugin name="gz::sim::systems::Thruster"
      filename="gz-sim-thruster-system">
      <joint_name>left_engine_propeller_joint</joint_name>
      <thrust_coefficient>0.004422</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.2</propeller_diameter>
      <velocity_control>true</velocity_control>
    </plugin>

    <plugin name="gz::sim::systems::Thruster"
      filename="gz-sim-thruster-system">
      <joint_name>right_engine_propeller_joint</joint_name>
      <thrust_coefficient>0.004422</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.2</propeller_diameter>
      <velocity_control>true</velocity_control>
    </plugin>

    <plugin name="gz::sim::systems::Hydrodynamics"
      filename="gz-sim-hydrodynamics-system">
      <link_name>base_link</link_name>
      <xDotU>0.0</xDotU>
      <yDotV>0.0</yDotV>
      <zDotW>0.0</zDotW>
      <kDotP>0.0</kDotP>
      <mDotQ>0.0</mDotQ>
      <nDotR>0.0</nDotR>
      <xU>-20.0</xU>
      <xUabsU>-35.0</xUabsU>
      <yV>-30.0</yV>
      <yVabsV>0.0</yVabsV>
      <zW>-250.0</zW>
      <kP>-25.0</kP>
      <mQ>-25.0</mQ>
      <nR>-180.0</nR>
      <nRabsR>0.0</nRabsR>
    </plugin>

    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <imuName>imu_link::imu_sensor</imuName>

      <control channel="0">
        <jointName>left_engine_propeller_joint</jointName>
        <multiplier>450</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/wamv/joint/left_engine_propeller_joint/cmd_thrust</cmd_topic>
      </control>

      <control channel="2">
        <jointName>right_engine_propeller_joint</jointName>
        <multiplier>450</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/wamv/joint/right_engine_propeller_joint/cmd_thrust</cmd_topic>
      </control>
    </plugin>
  </model>
</sdf>
